# Talento PyME v7.9.7
# Configuración sugerida para Capacidad operativa y resguardo

ADMIN_DB_WARNING_MB=256
ADMIN_DB_CRITICAL_MB=512

# Consola / proveedor
ADMIN_INFRA_URL=https://TU-CONSOLA-DE-INFRAESTRUCTURA
ADMIN_BACKUP_URL=https://TU-CONSOLA-DE-BACKUP-O-PROVEEDOR
ADMIN_UPGRADE_URL=https://TU-PANEL-DE-UPGRADE-DB

# Política visible en Superadministración
ADMIN_BACKUP_MODE=AUTOMATIC
ADMIN_BACKUP_FREQUENCY=DAILY
ADMIN_BACKUP_RETENTION_DAYS=2
ADMIN_BACKUP_PROVIDER=EXTERNAL_PROVIDER
ADMIN_LOCAL_BACKUP_ENABLED=true
ADMIN_BACKUP_CHECK_MINUTES=360
ADMIN_BACKUP_KEEP_FILES=2

# Protección anti-regresión del backup lógico
ADMIN_BACKUP_MIN_SAFE_RATIO=0.8
# URL opcional del proveedor cuando no exista panel de upgrade directo
ADMIN_PROVIDER_CONSOLE_URL=

# Correo institucional único: consultas + recuperación + panel de correo
FACTORY_SUPPORT_EMAIL=talentopyme00@gmail.com
GMAIL_APP_PASSWORD=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_FROM_NAME=Talento PyME
WEB_BASE_URL=https://talento-pyme.onrender.com
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_MAX_REQUESTS_15M=3
MAILBOX_FOLDER=INBOX

# Reportes ejecutivos (opcional)
TRACEABILITY_REPORT_RECIPIENT=nestor.manucci@tecnolok.com.ar

# IA generativa de presentación profesional (opcional pero recomendada)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_PRESENTATION_TIMEOUT_MS=18000

# Seguridad v9.1.0 · orígenes adicionales autorizados por CORS (opcional, separados por coma).
SECURITY_ALLOWED_ORIGINS=

# Reduce consultas automáticas inactivas a la base. Las altas y campañas despiertan la cola por evento.
COMMUNICATION_WORKER_RECOVERY_HOURS="6"
SUPPORT_MAILBOX_SYNC_INTERVAL_MINUTES="360"
