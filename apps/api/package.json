{
  "name": "talento-pyme-api",
  "version": "7.10.4",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "prestart": "prisma generate && prisma db execute --file prisma/migrations/20260927_v7104_additive/migration.sql --schema prisma/schema.prisma",
    "start": "node src/index.js",
    "prisma:generate": "prisma generate",
    "test": "node --test test/*.test.js",
    "db:migrate:safe": "prisma db execute --file prisma/migrations/20260927_v7104_additive/migration.sql --schema prisma/schema.prisma",
    "db:push:dev": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "imapflow": "^1.6.1",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.14",
    "mammoth": "^1.8.0",
    "multer": "^2.4.0",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.0.0"
  }
}
